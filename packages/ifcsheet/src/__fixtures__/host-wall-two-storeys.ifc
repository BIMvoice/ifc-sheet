ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('host-wall-two-storeys.ifc','2026-10-30T00:00:00',('IfcSheet'),('IfcSheet'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* A 6 m double-height wall A (x 0..6, y 0..0.3) contained in Level 0 and cut by the plans of both storeys (cuts 1.2 m and 4.2 m). */
/* Level 0 holds a door in it over 0 to 2.1 m; Level 1 (floor 3 m) holds a window in it over 4.5 to 5.1 m (above the 4.2 m cut). */
/* The host-wall rule (#586) draws each on the plan of its own storey only: the door never on Level 1, the Level 1 window never on Level 0. */
#1=IFCPROJECT('3hostTwoProject000001',$,'Two storeys',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#25=IFCCARTESIANPOINT((0.,0.,3.));
#26=IFCAXIS2PLACEMENT3D(#25,#11,#12);
#27=IFCLOCALPLACEMENT(#23,#26);
#30=IFCSITE('3hostTwoSite00000001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3hostTwoBuilding0001',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3hostTwoLevel00000001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#33=IFCBUILDINGSTOREY('3hostTwoLevel00000002',$,'Level 1',$,$,#27,$,$,.ELEMENT.,3.);
#34=IFCRELAGGREGATES('3hostTwoAggProject001',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3hostTwoAggSite000001',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3hostTwoAggBuilding01',$,$,$,#31,(#32,#33));
#40=IFCDIRECTION((1.,0.));
#41=IFCCARTESIANPOINT((3.,0.15));
#42=IFCAXIS2PLACEMENT2D(#41,#40);
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'A',#42,6.,0.3);
#44=IFCEXTRUDEDAREASOLID(#43,#13,#11,6.);
#45=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#44));
#46=IFCPRODUCTDEFINITIONSHAPE($,$,(#45));
#47=IFCLOCALPLACEMENT(#24,#13);
#48=IFCWALL('3hostTwoWallA00000001',$,'Wall A',$,$,#47,#46,$,.STANDARD.);
#50=IFCCARTESIANPOINT((0.15,3.));
#51=IFCAXIS2PLACEMENT2D(#50,#40);
#52=IFCRECTANGLEPROFILEDEF(.AREA.,'B',#51,0.3,6.);
#53=IFCEXTRUDEDAREASOLID(#52,#13,#11,3.);
#54=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#53));
#55=IFCPRODUCTDEFINITIONSHAPE($,$,(#54));
#57=IFCWALL('3hostTwoWallB00000001',$,'Wall B',$,$,#47,#55,$,.STANDARD.);
#63=IFCCARTESIANPOINT((0.,0.));
#64=IFCAXIS2PLACEMENT2D(#63,#40);
#60=IFCCARTESIANPOINT((2.5,0.15,0.));
#61=IFCAXIS2PLACEMENT3D(#60,#11,#12);
#62=IFCLOCALPLACEMENT(#24,#61);
#65=IFCRECTANGLEPROFILEDEF(.AREA.,'Opening',#64,1.,0.5);
#66=IFCEXTRUDEDAREASOLID(#65,#13,#11,2.1);
#67=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#66));
#68=IFCPRODUCTDEFINITIONSHAPE($,$,(#67));
#69=IFCOPENINGELEMENT('3hostTwoOpening00000001',$,'Opening',$,$,#62,#68,$,.OPENING.);
#70=IFCRELVOIDSELEMENT('3hostTwoVoids00000001',$,$,$,#48,#69);
#71=IFCRECTANGLEPROFILEDEF(.AREA.,'Door',#64,0.9,0.2);
#72=IFCEXTRUDEDAREASOLID(#71,#13,#11,2.1);
#73=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#72));
#74=IFCPRODUCTDEFINITIONSHAPE($,$,(#73));
#75=IFCDOOR('3hostTwoLowerDoor00001',$,'Lower door',$,$,#62,#74,$,2.1,0.9,.DOOR.,.SINGLE_SWING_LEFT.,$);
#76=IFCRELFILLSELEMENT('3hostTwoFills000000001',$,$,$,#69,#75);
#80=IFCCARTESIANPOINT((5.,0.15,1.5));
#81=IFCAXIS2PLACEMENT3D(#80,#11,#12);
#82=IFCLOCALPLACEMENT(#27,#81);
#83=IFCEXTRUDEDAREASOLID(#65,#13,#11,0.6);
#84=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#83));
#85=IFCPRODUCTDEFINITIONSHAPE($,$,(#84));
#86=IFCOPENINGELEMENT('3hostTwoOpening00000002',$,'Opening 2',$,$,#82,#85,$,.OPENING.);
#87=IFCRELVOIDSELEMENT('3hostTwoVoids00000002',$,$,$,#48,#86);
#88=IFCRECTANGLEPROFILEDEF(.AREA.,'Window',#64,0.9,0.2);
#89=IFCEXTRUDEDAREASOLID(#88,#13,#11,0.6);
#91=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#89));
#92=IFCPRODUCTDEFINITIONSHAPE($,$,(#91));
#93=IFCWINDOW('3hostTwoUpperWindow001',$,'Upper window',$,$,#82,#92,$,0.6,0.9,.WINDOW.,.SINGLE_PANEL.,$);
#94=IFCRELFILLSELEMENT('3hostTwoFills000000002',$,$,$,#86,#93);
#95=IFCRELCONTAINEDINSPATIALSTRUCTURE('3hostTwoContainL0000001',$,$,$,(#48,#57,#75),#32);
#96=IFCRELCONTAINEDINSPATIALSTRUCTURE('3hostTwoContainL1000001',$,$,$,(#93),#33);
ENDSEC;
END-ISO-10303-21;
