ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Hand-written IFC4 fixture for the schedule filters (issue 186): eight doors and windows on two storeys, IsExternal true, false and absent, classes IfcDoor, IfcDoorStandardCase and IfcWindow, predefined types DOOR, GATE, NOTDEFINED, WINDOW and SKYLIGHT, no geometry.'),'2;1');
FILE_NAME('exterior-interior.ifc','2026-10-24T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
