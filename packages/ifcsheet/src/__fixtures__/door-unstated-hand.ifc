DATA;
/* Level 0 holds four free doors, 0.9 m wide, 0.1 m deep and 2.1 m high, each with its hinge at its placement's local x = 0 (#679).
   A turned 0 degrees, B turned 90, C turned 180, all three with no OperationType (B states NOTDEFINED); D turned 0 and stating SINGLE_SWING_LEFT. */
#1=IFCPROJECT('3doorHandProject000001',$,'Host wall',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#30=IFCSITE('3doorHandSite00000001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3doorHandBuilding0001',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3doorHandLevel00000001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3doorHandAggProject001',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3doorHandAggSite000001',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3doorHandAggBuilding01',$,$,$,#31,(#32));
#40=IFCDIRECTION((1.,0.));
#41=IFCCARTESIANPOINT((0.45,0.05));
#42=IFCAXIS2PLACEMENT2D(#41,#40);
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf',#42,0.9,0.1);
#44=IFCEXTRUDEDAREASOLID(#43,#13,#11,2.1);
#45=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#44));
#46=IFCPRODUCTDEFINITIONSHAPE($,$,(#45));
#50=IFCCARTESIANPOINT((1.,1.,0.));
#51=IFCAXIS2PLACEMENT3D(#50,#11,#12);
#52=IFCLOCALPLACEMENT(#24,#51);
#53=IFCDOOR('3doorHandDoorA00000001',$,'A',$,$,#52,#46,$,2.1,0.9,.DOOR.,$,$);
#60=IFCCARTESIANPOINT((5.,1.,0.));
#61=IFCDIRECTION((0.,1.,0.));
#62=IFCAXIS2PLACEMENT3D(#60,#11,#61);
#63=IFCLOCALPLACEMENT(#24,#62);
#64=IFCDOOR('3doorHandDoorB00000001',$,'B',$,$,#63,#46,$,2.1,0.9,.DOOR.,.NOTDEFINED.,$);
#70=IFCCARTESIANPOINT((1.,5.,0.));
#71=IFCDIRECTION((-1.,0.,0.));
#72=IFCAXIS2PLACEMENT3D(#70,#11,#71);
#73=IFCLOCALPLACEMENT(#24,#72);
#74=IFCDOOR('3doorHandDoorC00000001',$,'C',$,$,#73,#46,$,2.1,0.9,.DOOR.,$,$);
#80=IFCCARTESIANPOINT((5.,5.,0.));
#81=IFCAXIS2PLACEMENT3D(#80,#11,#12);
#82=IFCLOCALPLACEMENT(#24,#81);
#83=IFCDOOR('3doorHandDoorD00000001',$,'D',$,$,#82,#46,$,2.1,0.9,.DOOR.,.SINGLE_SWING_LEFT.,$);
#90=IFCRELCONTAINEDINSPATIALSTRUCTURE('3doorHandContain0000001',$,$,$,(#53,#64,#74,#83),#32);
ENDSEC;
