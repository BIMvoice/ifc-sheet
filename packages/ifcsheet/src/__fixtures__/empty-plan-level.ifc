ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('empty-plan-level.ifc','2026-10-31T00:00:00',('IfcSheet'),('IfcSheet'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Two levels. Level 0 (floor 0 m) holds nothing, so its plan, cut at 1.2 m, draws nothing (#615). Level 1 (floor 10 m) holds a 3 m wall that its 11.2 m cut meets. */
#1=IFCPROJECT('3emptyPlanProject0001',$,'Empty plan',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#25=IFCCARTESIANPOINT((0.,0.,10.));
#26=IFCAXIS2PLACEMENT3D(#25,#11,#12);
#27=IFCLOCALPLACEMENT(#23,#26);
#30=IFCSITE('3emptyPlanSite00000001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3emptyPlanBuilding0001',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3emptyPlanLevel0000001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#33=IFCBUILDINGSTOREY('3emptyPlanLevel0000002',$,'Level 1',$,$,#27,$,$,.ELEMENT.,10.);
#34=IFCRELAGGREGATES('3emptyPlanAggProject01',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3emptyPlanAggSite00001',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3emptyPlanAggBuilding1',$,$,$,#31,(#32,#33));
#40=IFCDIRECTION((1.,0.));
#41=IFCCARTESIANPOINT((3.,0.15));
#42=IFCAXIS2PLACEMENT2D(#41,#40);
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'A',#42,6.,0.3);
#51=IFCEXTRUDEDAREASOLID(#43,#13,#11,3.);
#52=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#51));
#53=IFCPRODUCTDEFINITIONSHAPE($,$,(#52));
#54=IFCLOCALPLACEMENT(#27,#13);
#55=IFCWALL('3emptyPlanWallB0000001',$,'Wall B',$,$,#54,#53,$,.STANDARD.);
#96=IFCRELCONTAINEDINSPATIALSTRUCTURE('3emptyPlanContainL10001',$,$,$,(#55),#33);
ENDSEC;
END-ISO-10303-21;
