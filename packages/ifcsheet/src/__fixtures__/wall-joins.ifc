ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('wall-joins.ifc','2026-11-10T00:00:00',('IfcSheet'),('IfcSheet'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* #349: walls meeting as Bonsai models them, 3 m high on Level 0. Brick walls A (x 0..8, y 0..0.3) and B (x 0..0.3, y 0..6) */
/* meet in a mitred corner: each ends on the diagonal from (0,0) to (0.3,0.3). Brick wall C (x 4..4.2, y 0.3..6) butts into */
/* A's inner face, a T. Concrete wall D (x 6..6.2, y 0.3..6) butts into A the same way: another material, so its joint stays. */
#1=IFCPROJECT('3wallJoinsProject00001',$,'Wall joins',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#30=IFCSITE('3wallJoinsSite00000001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3wallJoinsBuilding0001',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3wallJoinsLevel0000001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3wallJoinsAggProject01',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3wallJoinsAggSite00001',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3wallJoinsAggBuilding1',$,$,$,#31,(#32));
#40=IFCLOCALPLACEMENT(#24,#13);
#41=IFCCARTESIANPOINT((0.,0.));
#42=IFCCARTESIANPOINT((8.,0.));
#43=IFCCARTESIANPOINT((8.,0.3));
#44=IFCCARTESIANPOINT((0.3,0.3));
#45=IFCPOLYLINE((#41,#42,#43,#44,#41));
#46=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'A',#45);
#47=IFCEXTRUDEDAREASOLID(#46,#13,#11,3.);
#48=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#47));
#49=IFCPRODUCTDEFINITIONSHAPE($,$,(#48));
#50=IFCWALL('3wallJoinsWallA0000001',$,'Wall A',$,$,#40,#49,$,.STANDARD.);
#51=IFCCARTESIANPOINT((0.3,6.));
#52=IFCCARTESIANPOINT((0.,6.));
#53=IFCPOLYLINE((#41,#44,#51,#52,#41));
#54=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'B',#53);
#55=IFCEXTRUDEDAREASOLID(#54,#13,#11,3.);
#56=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#55));
#57=IFCPRODUCTDEFINITIONSHAPE($,$,(#56));
#58=IFCWALL('3wallJoinsWallB0000001',$,'Wall B',$,$,#40,#57,$,.STANDARD.);
#60=IFCCARTESIANPOINT((4.,0.3));
#61=IFCCARTESIANPOINT((4.2,0.3));
#62=IFCCARTESIANPOINT((4.2,6.));
#63=IFCCARTESIANPOINT((4.,6.));
#64=IFCPOLYLINE((#60,#61,#62,#63,#60));
#65=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'C',#64);
#66=IFCEXTRUDEDAREASOLID(#65,#13,#11,3.);
#67=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#66));
#68=IFCPRODUCTDEFINITIONSHAPE($,$,(#67));
#69=IFCWALL('3wallJoinsWallC0000001',$,'Wall C',$,$,#40,#68,$,.STANDARD.);
#70=IFCCARTESIANPOINT((6.,0.3));
#71=IFCCARTESIANPOINT((6.2,0.3));
#72=IFCCARTESIANPOINT((6.2,6.));
#73=IFCCARTESIANPOINT((6.,6.));
#74=IFCPOLYLINE((#70,#71,#72,#73,#70));
#75=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'D',#74);
#76=IFCEXTRUDEDAREASOLID(#75,#13,#11,3.);
#77=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#76));
#78=IFCPRODUCTDEFINITIONSHAPE($,$,(#77));
#79=IFCWALL('3wallJoinsWallD0000001',$,'Wall D',$,$,#40,#78,$,.STANDARD.);
#80=IFCMATERIAL('Brick',$,$);
#81=IFCMATERIAL('Concrete',$,$);
#82=IFCRELASSOCIATESMATERIAL('3wallJoinsBrick0000001',$,$,$,(#50,#58,#69),#80);
#83=IFCRELASSOCIATESMATERIAL('3wallJoinsConcrete0001',$,$,$,(#79),#81);
#90=IFCRELCONTAINEDINSPATIALSTRUCTURE('3wallJoinsContainL0001',$,$,$,(#50,#58,#69,#79),#32);
ENDSEC;
END-ISO-10303-21;
