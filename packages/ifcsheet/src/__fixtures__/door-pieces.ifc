ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('door-pieces.ifc','2026-11-25T00:00:00',('IfcSheet'),('IfcSheet'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Level 0 holds a 3 m high wall (x 0..8, y 0..0.2) with three openings. Opening 1 (x 1..2) is filled by Door A (#95), a 1.0 m leaf. */
/* A second IfcDoor, 'stelkozijn' (#105), is a piece of Door A, as ArchiCAD exports a sub-frame: two 40 mm posts at the jambs, the wall's */
/* depth, 2.15 m high, filling no opening. Opening 2 (x 4..5.6) holds a double door as two IfcDoors: leaf L1 (#117, x 4..4.8) fills the */
/* opening, leaf L2 (#125, x 4.8..5.6) fills none. Opening 3 (x 6.5..7.1) holds a narrow 0.6 m door (#135) that fills none. */
#1=IFCPROJECT('3doorPiecesProject0001',$,'Door pieces',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#30=IFCSITE('3doorPiecesSite0000010',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3doorPiecesBuilding010',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3doorPiecesLevel000010',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3doorPiecesAggProjec10',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3doorPiecesAggSite0010',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3doorPiecesAggBuild010',$,$,$,#31,(#32));
#40=IFCDIRECTION((1.,0.));
#41=IFCCARTESIANPOINT((4.,0.1));
#42=IFCAXIS2PLACEMENT2D(#41,#40);
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall',#42,8.,0.2);
#44=IFCEXTRUDEDAREASOLID(#43,#13,#11,3.);
#45=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#44));
#46=IFCPRODUCTDEFINITIONSHAPE($,$,(#45));
#47=IFCLOCALPLACEMENT(#24,#13);
#48=IFCWALL('3doorPiecesWall0000010',$,'Wall',$,$,#47,#46,$,.STANDARD.);
/* Opening 1, x 1..2. */
#50=IFCCARTESIANPOINT((1.5,0.1,0.));
#51=IFCAXIS2PLACEMENT3D(#50,#11,#12);
#52=IFCLOCALPLACEMENT(#24,#51);
#53=IFCCARTESIANPOINT((0.,0.));
#54=IFCAXIS2PLACEMENT2D(#53,#40);
#55=IFCRECTANGLEPROFILEDEF(.AREA.,'Opening',#54,1.,0.5);
#56=IFCEXTRUDEDAREASOLID(#55,#13,#11,2.1);
#57=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#56));
#58=IFCPRODUCTDEFINITIONSHAPE($,$,(#57));
#59=IFCOPENINGELEMENT('3doorPiecesOpening0010',$,'Opening 1',$,$,#52,#58,$,.OPENING.);
#60=IFCRELVOIDSELEMENT('3doorPiecesVoids000010',$,$,$,#48,#59);
/* Door A: a 1.0 m by 40 mm leaf in the middle of the wall, its placement at the x = 1 jamb. */
#70=IFCCARTESIANPOINT((0.5,0.1));
#71=IFCAXIS2PLACEMENT2D(#70,#40);
#72=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf',#71,1.,0.04);
#73=IFCEXTRUDEDAREASOLID(#72,#13,#11,2.1);
#90=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#73));
#91=IFCPRODUCTDEFINITIONSHAPE($,$,(#90));
#92=IFCCARTESIANPOINT((1.,0.,0.));
#93=IFCAXIS2PLACEMENT3D(#92,#11,#12);
#94=IFCLOCALPLACEMENT(#24,#93);
#95=IFCDOOR('3doorPiecesDoorA000010',$,'Door A',$,$,#94,#91,$,2.1,1.,.DOOR.,.SINGLE_SWING_LEFT.,$);
#96=IFCRELFILLSELEMENT('3doorPiecesFills000010',$,$,$,#59,#95);
/* The piece: two 40 mm posts, the wall's depth, outside the jambs (x 0.96..1 and 2..2.04), its placement at x = 0.96. */
#97=IFCCARTESIANPOINT((0.02,0.1));
#98=IFCAXIS2PLACEMENT2D(#97,#40);
#99=IFCRECTANGLEPROFILEDEF(.AREA.,'Post',#98,0.04,0.2);
#100=IFCEXTRUDEDAREASOLID(#99,#13,#11,2.15);
#101=IFCCARTESIANPOINT((1.06,0.1));
#102=IFCAXIS2PLACEMENT2D(#101,#40);
#103=IFCRECTANGLEPROFILEDEF(.AREA.,'Post',#102,0.04,0.2);
#104=IFCEXTRUDEDAREASOLID(#103,#13,#11,2.15);
#106=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#100,#104));
#107=IFCPRODUCTDEFINITIONSHAPE($,$,(#106));
#108=IFCCARTESIANPOINT((0.96,0.,0.));
#109=IFCAXIS2PLACEMENT3D(#108,#11,#12);
#110=IFCLOCALPLACEMENT(#24,#109);
#105=IFCDOOR('3doorPiecesPiece000010',$,'stelkozijn',$,$,#110,#107,$,$,$,.DOOR.,.NOTDEFINED.,$);
/* Opening 2, x 4..5.6, and the double door's two 0.8 m leaves. */
#111=IFCCARTESIANPOINT((4.8,0.1,0.));
#112=IFCAXIS2PLACEMENT3D(#111,#11,#12);
#113=IFCLOCALPLACEMENT(#24,#112);
#114=IFCRECTANGLEPROFILEDEF(.AREA.,'Opening',#54,1.6,0.5);
#115=IFCEXTRUDEDAREASOLID(#114,#13,#11,2.1);
#116=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#115));
#118=IFCPRODUCTDEFINITIONSHAPE($,$,(#116));
#119=IFCOPENINGELEMENT('3doorPiecesOpening0020',$,'Opening 2',$,$,#113,#118,$,.OPENING.);
#120=IFCRELVOIDSELEMENT('3doorPiecesVoids000020',$,$,$,#48,#119);
#121=IFCCARTESIANPOINT((0.4,0.1));
#122=IFCAXIS2PLACEMENT2D(#121,#40);
#123=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf',#122,0.8,0.04);
#124=IFCEXTRUDEDAREASOLID(#123,#13,#11,2.1);
#126=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#124));
#127=IFCPRODUCTDEFINITIONSHAPE($,$,(#126));
#128=IFCCARTESIANPOINT((4.,0.,0.));
#129=IFCAXIS2PLACEMENT3D(#128,#11,#12);
#130=IFCLOCALPLACEMENT(#24,#129);
#117=IFCDOOR('3doorPiecesLeafL100010',$,'Leaf L1',$,$,#130,#127,$,2.1,0.8,.DOOR.,.SINGLE_SWING_LEFT.,$);
#131=IFCRELFILLSELEMENT('3doorPiecesFills000020',$,$,$,#119,#117);
#132=IFCCARTESIANPOINT((4.8,0.,0.));
#133=IFCAXIS2PLACEMENT3D(#132,#11,#12);
#134=IFCLOCALPLACEMENT(#24,#133);
#125=IFCDOOR('3doorPiecesLeafL200010',$,'Leaf L2',$,$,#134,#127,$,2.1,0.8,.DOOR.,.SINGLE_SWING_RIGHT.,$);
/* Opening 3, x 6.5..7.1, and a narrow 0.6 m door that fills none. */
#136=IFCCARTESIANPOINT((6.8,0.1,0.));
#137=IFCAXIS2PLACEMENT3D(#136,#11,#12);
#138=IFCLOCALPLACEMENT(#24,#137);
#139=IFCRECTANGLEPROFILEDEF(.AREA.,'Opening',#54,0.6,0.5);
#140=IFCEXTRUDEDAREASOLID(#139,#13,#11,2.1);
#141=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#140));
#142=IFCPRODUCTDEFINITIONSHAPE($,$,(#141));
#143=IFCOPENINGELEMENT('3doorPiecesOpening0030',$,'Opening 3',$,$,#138,#142,$,.OPENING.);
#144=IFCRELVOIDSELEMENT('3doorPiecesVoids000030',$,$,$,#48,#143);
#145=IFCCARTESIANPOINT((0.3,0.1));
#146=IFCAXIS2PLACEMENT2D(#145,#40);
#147=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf',#146,0.6,0.04);
#148=IFCEXTRUDEDAREASOLID(#147,#13,#11,2.1);
#149=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#148));
#150=IFCPRODUCTDEFINITIONSHAPE($,$,(#149));
#151=IFCCARTESIANPOINT((6.5,0.,0.));
#152=IFCAXIS2PLACEMENT3D(#151,#11,#12);
#153=IFCLOCALPLACEMENT(#24,#152);
#135=IFCDOOR('3doorPiecesNarrow00010',$,'Narrow door',$,$,#153,#150,$,2.1,0.6,.DOOR.,.SINGLE_SWING_LEFT.,$);
#160=IFCRELCONTAINEDINSPATIALSTRUCTURE('3doorPiecesContain0010',$,$,$,(#48,#95,#105,#117,#125,#135),#32);
ENDSEC;
END-ISO-10303-21;
