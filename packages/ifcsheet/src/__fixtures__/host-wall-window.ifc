ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('host-wall-window.ifc','2026-10-30T00:00:00',('IfcSheet'),('IfcSheet'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Level 0 holds a 3 m high wall A (x 0..6, y 0..0.3) with a window in it whose sill is 1.5 m up (0.3 m over the 1.2 m plan cut), */
/* through an opening and the IfcRelVoidsElement / IfcRelFillsElement pair; a second wall B (x 0..0.3, y 0..6) so the plan has a corner; */
/* and an unhosted window of the same size and height standing free at x 8. */
#1=IFCPROJECT('3hostWallProject000001',$,'Host wall',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#30=IFCSITE('3hostWallSite00000001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3hostWallBuilding0001',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3hostWallLevel00000001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3hostWallAggProject001',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3hostWallAggSite000001',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3hostWallAggBuilding01',$,$,$,#31,(#32));
#40=IFCDIRECTION((1.,0.));
#41=IFCCARTESIANPOINT((3.,0.15));
#42=IFCAXIS2PLACEMENT2D(#41,#40);
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'A',#42,6.,0.3);
#44=IFCEXTRUDEDAREASOLID(#43,#13,#11,3.);
#45=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#44));
#46=IFCPRODUCTDEFINITIONSHAPE($,$,(#45));
#47=IFCLOCALPLACEMENT(#24,#13);
#48=IFCWALL('3hostWallWallA00000001',$,'Wall A',$,$,#47,#46,$,.STANDARD.);
#50=IFCCARTESIANPOINT((0.15,3.));
#51=IFCAXIS2PLACEMENT2D(#50,#40);
#52=IFCRECTANGLEPROFILEDEF(.AREA.,'B',#51,0.3,6.);
#53=IFCEXTRUDEDAREASOLID(#52,#13,#11,3.);
#54=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#53));
#55=IFCPRODUCTDEFINITIONSHAPE($,$,(#54));
#57=IFCWALL('3hostWallWallB00000001',$,'Wall B',$,$,#47,#55,$,.STANDARD.);
#60=IFCCARTESIANPOINT((2.5,0.15,1.5));
#61=IFCAXIS2PLACEMENT3D(#60,#11,#12);
#62=IFCLOCALPLACEMENT(#24,#61);
#63=IFCCARTESIANPOINT((0.,0.));
#64=IFCAXIS2PLACEMENT2D(#63,#40);
#65=IFCRECTANGLEPROFILEDEF(.AREA.,'Opening',#64,1.,0.5);
#66=IFCEXTRUDEDAREASOLID(#65,#13,#11,0.6);
#67=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#66));
#68=IFCPRODUCTDEFINITIONSHAPE($,$,(#67));
#69=IFCOPENINGELEMENT('3hostWallOpening00000001',$,'Opening',$,$,#62,#68,$,.OPENING.);
#70=IFCRELVOIDSELEMENT('3hostWallVoids00000001',$,$,$,#48,#69);
#71=IFCRECTANGLEPROFILEDEF(.AREA.,'Window',#64,0.9,0.2);
#72=IFCEXTRUDEDAREASOLID(#71,#13,#11,0.6);
#73=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#72));
#74=IFCPRODUCTDEFINITIONSHAPE($,$,(#73));
#75=IFCWINDOW('3hostWallHostedWindow01',$,'Hosted window',$,$,#62,#74,$,0.6,0.9,.WINDOW.,.SINGLE_PANEL.,$);
#76=IFCRELFILLSELEMENT('3hostWallFills000000001',$,$,$,#69,#75);
#80=IFCCARTESIANPOINT((8.,0.15,1.5));
#81=IFCAXIS2PLACEMENT3D(#80,#11,#12);
#82=IFCLOCALPLACEMENT(#24,#81);
#83=IFCWINDOW('3hostWallFreeWindow0001',$,'Unhosted window',$,$,#82,#74,$,0.6,0.9,.WINDOW.,.SINGLE_PANEL.,$);
#90=IFCRELCONTAINEDINSPATIALSTRUCTURE('3hostWallContainL0000001',$,$,$,(#48,#57,#75,#83),#32);
ENDSEC;
END-ISO-10303-21;
