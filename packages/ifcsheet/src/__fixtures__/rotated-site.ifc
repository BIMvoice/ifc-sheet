ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('rotated-site.ifc','2026-11-10T00:00:00',('IfcSheet'),('IfcSheet'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* A plan square to the building: four 3 m high walls 0.2 m thick round a 4 x 2 m box on Level 0, (0,0)-(4,2) in the */
/* building's own frame, in a site whose placement turns it 48 degrees counter-clockwise about Z. No TrueNorth: north is +Y. */
#1=IFCPROJECT('3rotatedSiteProject001',$,'Rotated site',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#16=IFCDIRECTION((0.6691306064,0.7431448255,0.));
#17=IFCAXIS2PLACEMENT3D(#10,#11,#16);
#22=IFCLOCALPLACEMENT($,#17);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#30=IFCSITE('3rotatedSiteSite000001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3rotatedSiteBuilding01',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3rotatedSiteLevel00001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3rotatedSiteAggProj001',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3rotatedSiteAggSite001',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3rotatedSiteAggBldg001',$,$,$,#31,(#32));
#40=IFCLOCALPLACEMENT(#24,#13);
#50=IFCCARTESIANPOINT((0.0,0.0));
#51=IFCCARTESIANPOINT((4.0,0.0));
#52=IFCCARTESIANPOINT((4.0,0.2));
#53=IFCCARTESIANPOINT((0.0,0.2));
#54=IFCPOLYLINE((#50,#51,#52,#53,#50));
#55=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'A',#54);
#56=IFCEXTRUDEDAREASOLID(#55,#13,#11,3.);
#57=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#56));
#58=IFCPRODUCTDEFINITIONSHAPE($,$,(#57));
#59=IFCWALL('3rotatedSiteWallA00001',$,'Wall A',$,$,#40,#58,$,.STANDARD.);
#60=IFCCARTESIANPOINT((0.0,1.8));
#61=IFCCARTESIANPOINT((4.0,1.8));
#62=IFCCARTESIANPOINT((4.0,2.0));
#63=IFCCARTESIANPOINT((0.0,2.0));
#64=IFCPOLYLINE((#60,#61,#62,#63,#60));
#65=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'B',#64);
#66=IFCEXTRUDEDAREASOLID(#65,#13,#11,3.);
#67=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#66));
#68=IFCPRODUCTDEFINITIONSHAPE($,$,(#67));
#69=IFCWALL('3rotatedSiteWallB00001',$,'Wall B',$,$,#40,#68,$,.STANDARD.);
#70=IFCCARTESIANPOINT((0.0,0.2));
#71=IFCCARTESIANPOINT((0.2,0.2));
#72=IFCCARTESIANPOINT((0.2,1.8));
#73=IFCCARTESIANPOINT((0.0,1.8));
#74=IFCPOLYLINE((#70,#71,#72,#73,#70));
#75=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'C',#74);
#76=IFCEXTRUDEDAREASOLID(#75,#13,#11,3.);
#77=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#76));
#78=IFCPRODUCTDEFINITIONSHAPE($,$,(#77));
#79=IFCWALL('3rotatedSiteWallC00001',$,'Wall C',$,$,#40,#78,$,.STANDARD.);
#80=IFCCARTESIANPOINT((3.8,0.2));
#81=IFCCARTESIANPOINT((4.0,0.2));
#82=IFCCARTESIANPOINT((4.0,1.8));
#83=IFCCARTESIANPOINT((3.8,1.8));
#84=IFCPOLYLINE((#80,#81,#82,#83,#80));
#85=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'D',#84);
#86=IFCEXTRUDEDAREASOLID(#85,#13,#11,3.);
#87=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#86));
#88=IFCPRODUCTDEFINITIONSHAPE($,$,(#87));
#89=IFCWALL('3rotatedSiteWallD00001',$,'Wall D',$,$,#40,#88,$,.STANDARD.);
#100=IFCRELCONTAINEDINSPATIALSTRUCTURE('3rotatedSiteContain001',$,$,$,(#59,#69,#79,#89),#32);
ENDSEC;
END-ISO-10303-21;
