ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('door-jamb-piece.ifc','2026-11-25T00:00:00',('IfcSheet'),('IfcSheet'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Level 0 holds a 0.1 m wall (y 0 to 0.1, 3 m high) with two door gaps 0.975 m wide, x 2 to 2.975 and x 6 to 6.975, each with one */
/* jamb closed by a thin IfcWall piece that runs across the wall (0.1 m long, the wall's thickness, and 0.03 m along it), as a large */
/* housing model exports them: Wall A from x 0 to 2; Piece 1 from x 2.975 to 3.005; Wall B from x 3.005 to 5.97; Piece 2 from x 5.97 */
/* to 6; a 0.095 m by 0.1 m stub from x 6.975 to 7.07; Wall D from x 7.07 to 9; Wall E at right angles, x 9 to 9.1, y 0 to 1.5 (so */
/* the plan's extent holds the swings). Door stands in the first gap (its jambs Wall A and */
/* Piece 1), Door B in the second (its jambs Piece 2 and the stub). No IfcOpeningElement and no IfcRelFillsElement: the model hosts */
/* the doors in no wall. Each body is a leaf (0.975 m by 0.04 m, mid-wall) and a frame 1.0 m wide (12.5 mm past each jamb) and */
/* 0.12 m deep (10 mm proud of each face). Each is placed at its left jamb with local +Y to +y and states SINGLE_SWING_LEFT: hinged */
/* on local -X, opening to local +Y. */
#1=IFCPROJECT('3doorJambPieceProject1',$,'Door jamb closed by a thin wall piece',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#30=IFCSITE('3doorJambPieceSite0001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3doorJambPieceBuilding',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3doorJambPieceLevel001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3doorJambPieceAggProj1',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3doorJambPieceAggSite1',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3doorJambPieceAggBldg1',$,$,$,#31,(#32));
#40=IFCDIRECTION((1.,0.));
#47=IFCLOCALPLACEMENT(#24,#13);
#41=IFCCARTESIANPOINT((1.,0.05));
#42=IFCAXIS2PLACEMENT2D(#41,#40);
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall A',#42,2.,0.1);
#44=IFCEXTRUDEDAREASOLID(#43,#13,#11,3.);
#45=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#44));
#46=IFCPRODUCTDEFINITIONSHAPE($,$,(#45));
#48=IFCWALL('3doorJambPieceWallA001',$,'Wall A',$,$,#47,#46,$,.STANDARD.);
#50=IFCCARTESIANPOINT((2.99,0.05));
#51=IFCAXIS2PLACEMENT2D(#50,#40);
#52=IFCRECTANGLEPROFILEDEF(.AREA.,'Piece 1',#51,0.03,0.1);
#53=IFCEXTRUDEDAREASOLID(#52,#13,#11,3.);
#54=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#53));
#55=IFCPRODUCTDEFINITIONSHAPE($,$,(#54));
#56=IFCWALL('3doorJambPiecePiece001',$,'Piece 1',$,$,#47,#55,$,.STANDARD.);
#60=IFCCARTESIANPOINT((4.4875,0.05));
#61=IFCAXIS2PLACEMENT2D(#60,#40);
#62=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall B',#61,2.965,0.1);
#63=IFCEXTRUDEDAREASOLID(#62,#13,#11,3.);
#64=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#63));
#65=IFCPRODUCTDEFINITIONSHAPE($,$,(#64));
#66=IFCWALL('3doorJambPieceWallB001',$,'Wall B',$,$,#47,#65,$,.STANDARD.);
#120=IFCCARTESIANPOINT((5.985,0.05));
#121=IFCAXIS2PLACEMENT2D(#120,#40);
#122=IFCRECTANGLEPROFILEDEF(.AREA.,'Piece 2',#121,0.03,0.1);
#123=IFCEXTRUDEDAREASOLID(#122,#13,#11,3.);
#124=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#123));
#125=IFCPRODUCTDEFINITIONSHAPE($,$,(#124));
#126=IFCWALL('3doorJambPiecePiece002',$,'Piece 2',$,$,#47,#125,$,.STANDARD.);
#130=IFCCARTESIANPOINT((7.0225,0.05));
#131=IFCAXIS2PLACEMENT2D(#130,#40);
#132=IFCRECTANGLEPROFILEDEF(.AREA.,'Stub',#131,0.095,0.1);
#133=IFCEXTRUDEDAREASOLID(#132,#13,#11,3.);
#134=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#133));
#135=IFCPRODUCTDEFINITIONSHAPE($,$,(#134));
#136=IFCWALL('3doorJambPieceStub0001',$,'Stub',$,$,#47,#135,$,.STANDARD.);
#140=IFCCARTESIANPOINT((8.035,0.05));
#141=IFCAXIS2PLACEMENT2D(#140,#40);
#142=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall D',#141,1.93,0.1);
#143=IFCEXTRUDEDAREASOLID(#142,#13,#11,3.);
#144=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#143));
#145=IFCPRODUCTDEFINITIONSHAPE($,$,(#144));
#146=IFCWALL('3doorJambPieceWallD001',$,'Wall D',$,$,#47,#145,$,.STANDARD.);
#150=IFCCARTESIANPOINT((9.05,0.75));
#151=IFCAXIS2PLACEMENT2D(#150,#40);
#152=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall E',#151,0.1,1.5);
#153=IFCEXTRUDEDAREASOLID(#152,#13,#11,3.);
#154=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#153));
#155=IFCPRODUCTDEFINITIONSHAPE($,$,(#154));
#156=IFCWALL('3doorJambPieceWallE001',$,'Wall E',$,$,#47,#155,$,.STANDARD.);
/* The doors' body, in its own placement (origin at the left jamb on the y = 0 face). */
#70=IFCCARTESIANPOINT((0.4875,0.05));
#71=IFCAXIS2PLACEMENT2D(#70,#40);
#72=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf',#71,0.975,0.04);
#73=IFCEXTRUDEDAREASOLID(#72,#13,#11,2.1);
#74=IFCCARTESIANPOINT((0.0125,0.05));
#75=IFCAXIS2PLACEMENT2D(#74,#40);
#76=IFCRECTANGLEPROFILEDEF(.AREA.,'Frame',#75,0.05,0.12);
#77=IFCEXTRUDEDAREASOLID(#76,#13,#11,2.15);
#78=IFCCARTESIANPOINT((0.9625,0.05));
#79=IFCAXIS2PLACEMENT2D(#78,#40);
#80=IFCRECTANGLEPROFILEDEF(.AREA.,'Frame',#79,0.05,0.12);
#81=IFCEXTRUDEDAREASOLID(#80,#13,#11,2.15);
#90=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#73,#77,#81));
#91=IFCPRODUCTDEFINITIONSHAPE($,$,(#90));
#92=IFCCARTESIANPOINT((2.,0.,0.));
#93=IFCAXIS2PLACEMENT3D(#92,#11,#12);
#94=IFCLOCALPLACEMENT(#24,#93);
#95=IFCDOOR('3doorJambPieceDoor0001',$,'Door',$,$,#94,#91,$,2.1,0.975,.DOOR.,.SINGLE_SWING_LEFT.,$);
#110=IFCCARTESIANPOINT((6.,0.,0.));
#111=IFCAXIS2PLACEMENT3D(#110,#11,#12);
#112=IFCLOCALPLACEMENT(#24,#111);
#113=IFCDOOR('3doorJambPieceDoor0002',$,'Door B',$,$,#112,#91,$,2.1,0.975,.DOOR.,.SINGLE_SWING_LEFT.,$);
#99=IFCRELCONTAINEDINSPATIALSTRUCTURE('3doorJambPieceContain1',$,$,$,(#48,#56,#66,#126,#136,#146,#156,#95,#113),#32);
ENDSEC;
END-ISO-10303-21;
