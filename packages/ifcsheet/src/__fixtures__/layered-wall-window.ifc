ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('layered-wall-window.ifc','2026-11-07T00:00:00',('IfcSheet'),('IfcSheet'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Level 0 holds one 2.7 m high wall (x 0..6, y 0..0.3) of three material layers, brick 0.14, insulation 0.12 and plaster 0.04 */
/* (IfcMaterialLayerSetUsage, AXIS2, POSITIVE), the way Bonsai writes one. Its opening runs x 2..2.6 and 1.0..1.9 m up, */
/* through the whole thickness, and holds a window. The opening's jamb faces stand at x 2 and x 2.6 (#749). */
#1=IFCPROJECT('3layWallProject0000001',$,'Layered wall',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#30=IFCSITE('3layWallSite0000000001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3layWallBuilding000001',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3layWallLevel000000001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3layWallAggProject0001',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3layWallAggSite0000001',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3layWallAggBuilding001',$,$,$,#31,(#32));
#40=IFCDIRECTION((1.,0.));
#41=IFCCARTESIANPOINT((3.,0.15));
#42=IFCAXIS2PLACEMENT2D(#41,#40);
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall',#42,6.,0.3);
#44=IFCEXTRUDEDAREASOLID(#43,#13,#11,2.7);
#45=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#44));
#46=IFCPRODUCTDEFINITIONSHAPE($,$,(#45));
#47=IFCLOCALPLACEMENT(#24,#13);
#48=IFCWALL('3layWallWall0000000001',$,'Layered wall',$,$,#47,#46,$,.STANDARD.);
#50=IFCMATERIAL('Brick',$,$);
#51=IFCMATERIAL('Insulation',$,$);
#52=IFCMATERIAL('Plaster',$,$);
#53=IFCMATERIALLAYER(#50,0.14,$,$,$,$,$);
#54=IFCMATERIALLAYER(#51,0.12,$,$,$,$,$);
#55=IFCMATERIALLAYER(#52,0.04,$,$,$,$,$);
#56=IFCMATERIALLAYERSET((#53,#54,#55),'WALL-300',$);
#57=IFCMATERIALLAYERSETUSAGE(#56,.AXIS2.,.POSITIVE.,0.,$);
#58=IFCRELASSOCIATESMATERIAL('3layWallMaterial000001',$,$,$,(#48),#57);
#60=IFCCARTESIANPOINT((2.,0.,1.));
#61=IFCAXIS2PLACEMENT3D(#60,#11,#12);
#62=IFCLOCALPLACEMENT(#47,#61);
#63=IFCCARTESIANPOINT((0.3,0.15));
#64=IFCAXIS2PLACEMENT2D(#63,#40);
#65=IFCRECTANGLEPROFILEDEF(.AREA.,'Opening',#64,0.6,1.2);
#66=IFCEXTRUDEDAREASOLID(#65,#13,#11,0.9);
#67=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#66));
#68=IFCPRODUCTDEFINITIONSHAPE($,$,(#67));
#69=IFCOPENINGELEMENT('3layWallOpening0000001',$,'Opening',$,$,#62,#68,$,.OPENING.);
#70=IFCRELVOIDSELEMENT('3layWallVoids000000001',$,$,$,#48,#69);
#71=IFCRECTANGLEPROFILEDEF(.AREA.,'Window',#64,0.6,0.05);
#72=IFCEXTRUDEDAREASOLID(#71,#13,#11,0.9);
#73=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#72));
#74=IFCPRODUCTDEFINITIONSHAPE($,$,(#73));
#75=IFCWINDOW('3layWallWindow00000001',$,'Window',$,$,#62,#74,$,0.9,0.6,.WINDOW.,.SINGLE_PANEL.,$);
#76=IFCRELFILLSELEMENT('3layWallFills000000001',$,$,$,#69,#75);
#90=IFCRELCONTAINEDINSPATIALSTRUCTURE('3layWallContainL000001',$,$,$,(#48,#75),#32);
ENDSEC;
END-ISO-10303-21;
