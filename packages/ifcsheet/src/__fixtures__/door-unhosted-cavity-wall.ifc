ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('door-unhosted-cavity-wall.ifc','2026-11-27T00:00:00',('IfcSheet'),('IfcSheet'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Level 0 holds one IfcWall of two 0.1 m leaves with a 5 mm cavity between them (no geometry for the cavity, as a layered */
/* partition exports it): leaf A from y 0 to 0.1, leaf B from y 0.105 to 0.205, 3 m high, each split at a 0.98 m gap from x 2 */
/* to 2.98. Door stands in leaf A with no IfcOpeningElement and no IfcRelFillsElement: the model hosts it in no wall. Its body */
/* is a leaf (0.04 m, mid-leaf A) and a frame 1.005 m wide (12.5 mm past each jamb) and 0.1 m deep, flush with leaf A. It is */
/* placed at its left jamb with local +Y to +y and states SINGLE_SWING_LEFT: hinged on local -X, opening to local +Y. */
#1=IFCPROJECT('3doorCavityProject0001',$,'Door in a cavity wall',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#30=IFCSITE('3doorCavitySite0000001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3doorCavityBuilding001',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3doorCavityLevel000001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3doorCavityAggProj001',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3doorCavityAggSite001',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3doorCavityAggBldg001',$,$,$,#31,(#32));
#40=IFCDIRECTION((1.,0.));
/* Leaf A, x 0 to 2 and x 2.98 to 5. */
#41=IFCCARTESIANPOINT((1.,0.05));
#42=IFCAXIS2PLACEMENT2D(#41,#40);
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf A west',#42,2.,0.1);
#44=IFCEXTRUDEDAREASOLID(#43,#13,#11,3.);
#45=IFCCARTESIANPOINT((3.99,0.05));
#46=IFCAXIS2PLACEMENT2D(#45,#40);
#47=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf A east',#46,2.02,0.1);
#48=IFCEXTRUDEDAREASOLID(#47,#13,#11,3.);
/* Leaf B, the same pieces from y 0.105 to 0.205. */
#51=IFCCARTESIANPOINT((1.,0.155));
#52=IFCAXIS2PLACEMENT2D(#51,#40);
#53=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf B west',#52,2.,0.1);
#54=IFCEXTRUDEDAREASOLID(#53,#13,#11,3.);
#55=IFCCARTESIANPOINT((3.99,0.155));
#56=IFCAXIS2PLACEMENT2D(#55,#40);
#57=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf B east',#56,2.02,0.1);
#58=IFCEXTRUDEDAREASOLID(#57,#13,#11,3.);
#60=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#44,#48,#54,#58));
#61=IFCPRODUCTDEFINITIONSHAPE($,$,(#60));
#62=IFCLOCALPLACEMENT(#24,#13);
#63=IFCWALL('3doorCavityWall000001',$,'Cavity wall',$,$,#62,#61,$,.STANDARD.);
/* The door's body, in its own placement (origin at the x = 2 jamb on the y = 0 face). */
#70=IFCCARTESIANPOINT((0.49,0.05));
#71=IFCAXIS2PLACEMENT2D(#70,#40);
#72=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf',#71,0.98,0.04);
#73=IFCEXTRUDEDAREASOLID(#72,#13,#11,2.1);
#74=IFCCARTESIANPOINT((0.0125,0.05));
#75=IFCAXIS2PLACEMENT2D(#74,#40);
#76=IFCRECTANGLEPROFILEDEF(.AREA.,'Frame',#75,0.05,0.1);
#77=IFCEXTRUDEDAREASOLID(#76,#13,#11,2.15);
#78=IFCCARTESIANPOINT((0.9675,0.05));
#79=IFCAXIS2PLACEMENT2D(#78,#40);
#80=IFCRECTANGLEPROFILEDEF(.AREA.,'Frame',#79,0.05,0.1);
#81=IFCEXTRUDEDAREASOLID(#80,#13,#11,2.15);
#90=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#73,#77,#81));
#91=IFCPRODUCTDEFINITIONSHAPE($,$,(#90));
#92=IFCCARTESIANPOINT((2.,0.,0.));
#93=IFCAXIS2PLACEMENT3D(#92,#11,#12);
#94=IFCLOCALPLACEMENT(#24,#93);
#95=IFCDOOR('3doorCavityDoor000001',$,'Door',$,$,#94,#91,$,2.1,0.98,.DOOR.,.SINGLE_SWING_LEFT.,$);
#99=IFCRELCONTAINEDINSPATIALSTRUCTURE('3doorCavityContain001',$,$,$,(#63,#95),#32);
ENDSEC;
END-ISO-10303-21;
