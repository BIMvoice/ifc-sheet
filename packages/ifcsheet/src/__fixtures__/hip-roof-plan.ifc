ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Hand-written IFC4 fixture for the roof plan (#490), shaped as Bonsai exports a roof: a Ground floor at 0, a Wall plate storey at 3.0 m and a Roof storey at 5.0 m with nothing in it. The hip roof is one IfcRoof with a body of its own (an IfcPolygonalFaceSet, not an extrusion), contained in the Wall plate storey: eaves at 3.0 m around 8 x 6 m, a ridge from (2,3) to (6,3) at 4.5 m and four hips. A 3 m wall stands on the ground floor under the south eave. No external data.'),'2;1');
FILE_NAME('hip-roof-plan.ifc','2026-11-10T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCCARTESIANPOINT((0.000,0.000,0.000));
#4=IFCAXIS2PLACEMENT3D(#3,$,$);
#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);
#6=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#5,$,.MODEL_VIEW.,$);
#7=IFCPROJECT('1HipRoofPlanProject001',$,'Hip roof plan fixture',$,$,$,$,(#5),#2);
#10=IFCLOCALPLACEMENT($,#4);
#13=IFCLOCALPLACEMENT(#10,#4);
#14=IFCSITE('1HipRoofPlanSite000001',$,'Site',$,$,#10,$,$,.ELEMENT.,$,$,$,$,$);
#15=IFCBUILDING('1HipRoofPlanBuilding01',$,'Building',$,$,#13,$,$,.ELEMENT.,$,$,$);
#18=IFCLOCALPLACEMENT(#13,#4);
#19=IFCBUILDINGSTOREY('1HipRoofPlanGround0001',$,'Ground floor',$,$,#18,$,$,.ELEMENT.,0.000);
#20=IFCCARTESIANPOINT((0.000,0.000,3.000));
#21=IFCAXIS2PLACEMENT3D(#20,$,$);
#22=IFCLOCALPLACEMENT(#13,#21);
#23=IFCBUILDINGSTOREY('1HipRoofPlanWallPlate1',$,'Wall plate',$,$,#22,$,$,.ELEMENT.,3.000);
#24=IFCCARTESIANPOINT((0.000,0.000,5.000));
#25=IFCAXIS2PLACEMENT3D(#24,$,$);
#26=IFCLOCALPLACEMENT(#13,#25);
#27=IFCBUILDINGSTOREY('1HipRoofPlanRoofStorey',$,'Roof',$,$,#26,$,$,.ELEMENT.,5.000);
#30=IFCCARTESIANPOINT((0.,0.));
#31=IFCAXIS2PLACEMENT2D(#30,$);
#32=IFCDIRECTION((0.,0.,1.));
#33=IFCRECTANGLEPROFILEDEF(.AREA.,$,#31,8.000,0.200);
#34=IFCEXTRUDEDAREASOLID(#33,#4,#32,3.000);
#35=IFCSHAPEREPRESENTATION(#6,'Body','SweptSolid',(#34));
#36=IFCPRODUCTDEFINITIONSHAPE($,$,(#35));
#37=IFCCARTESIANPOINT((4.000,0.100,0.000));
#38=IFCAXIS2PLACEMENT3D(#37,$,$);
#39=IFCLOCALPLACEMENT(#18,#38);
#40=IFCWALL('1HipRoofPlanSouthWall1',$,'South wall',$,$,#39,#36,$,.SOLIDWALL.);
#50=IFCCARTESIANPOINTLIST3D(((0.,0.,0.),(8.,0.,0.),(8.,6.,0.),(0.,6.,0.),(2.,3.,1.5),(6.,3.,1.5)),$);
#51=IFCINDEXEDPOLYGONALFACE((1,2,6,5));
#52=IFCINDEXEDPOLYGONALFACE((2,3,6));
#53=IFCINDEXEDPOLYGONALFACE((3,4,5,6));
#54=IFCINDEXEDPOLYGONALFACE((4,1,5));
#55=IFCINDEXEDPOLYGONALFACE((1,4,3,2));
#56=IFCPOLYGONALFACESET(#50,.T.,(#51,#52,#53,#54,#55),$);
#57=IFCSHAPEREPRESENTATION(#6,'Body','Tessellation',(#56));
#58=IFCPRODUCTDEFINITIONSHAPE($,$,(#57));
#59=IFCLOCALPLACEMENT(#22,#4);
#60=IFCROOF('1HipRoofPlanHipRoof001',$,'Roof',$,$,#59,#58,$,.HIP_ROOF.);
#70=IFCRELAGGREGATES('1HipRoofPlanAggr000001',$,$,$,#7,(#14));
#71=IFCRELAGGREGATES('1HipRoofPlanAggr000002',$,$,$,#14,(#15));
#72=IFCRELAGGREGATES('1HipRoofPlanAggr000003',$,$,$,#15,(#19,#23,#27));
#73=IFCRELCONTAINEDINSPATIALSTRUCTURE('1HipRoofPlanCont000001',$,$,$,(#40),#19);
#74=IFCRELCONTAINEDINSPATIALSTRUCTURE('1HipRoofPlanCont000002',$,$,$,(#60),#23);
ENDSEC;
