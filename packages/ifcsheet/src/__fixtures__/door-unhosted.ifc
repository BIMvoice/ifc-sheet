#105=IFCPRODUCTDEFINITIONSHAPE($,$,(#104));
#106=IFCWALL('3doorUnhostedWallE0001',$,'Stub',$,$,#47,#105,$,.STANDARD.);
#110=IFCCARTESIANPOINT((5.,0.,0.));
#111=IFCAXIS2PLACEMENT3D(#110,#11,#12);
#112=IFCLOCALPLACEMENT(#24,#111);
#113=IFCDOOR('3doorUnhostedDoor00002',$,'Door B',$,$,#112,#91,$,2.1,0.9,.DOOR.,.SINGLE_SWING_LEFT.,$);
#99=IFCRELCONTAINEDINSPATIALSTRUCTURE('3doorUnhostedContain01',$,$,$,(#48,#56,#66,#106,#95,#113),#32);
