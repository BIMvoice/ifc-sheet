#95=IFCDOOR('3doorUnhostedDoor00001',$,'Door',$,$,#94,#91,$,2.1,0.9,.DOOR.,.SINGLE_SWING_LEFT.,$);
#100=IFCCARTESIANPOINT((5.95,0.05));
#101=IFCAXIS2PLACEMENT2D(#100,#40);
#102=IFCRECTANGLEPROFILEDEF(.AREA.,'Stub',#101,0.1,0.1);
