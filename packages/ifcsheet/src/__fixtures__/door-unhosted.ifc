#31=IFCBUILDING('3doorUnhostedBuilding1',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3doorUnhostedLevel0001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3doorUnhostedAggProj01',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3doorUnhostedAggSite01',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3doorUnhostedAggBldg01',$,$,$,#31,(#32));
#40=IFCDIRECTION((1.,0.));
#41=IFCCARTESIANPOINT((1.,0.05));
