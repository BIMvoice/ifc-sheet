DATA;
/* Level 0 holds a 0.1 m wall (y 0 to 0.1, 3 m high) split at two doors: pieces from x 0 to 2 and from x 2.9 to 5, and a 0.1 m by */
/* 0.1 m stub from x 5.9 to 6; and a 0.1 m wall at right angles from x 3.1 to 3.2, y 0.1 to 1.1, 0.2 m past the first door's jamb. */
/* Door stands in the 0.9 m gap from x 2 to 2.9, Door B in the gap from x 5 to 5.9 (its far jamb the stub), with no IfcOpeningElement */
/* and no IfcRelFillsElement: the model hosts them in no wall, as many exports leave their doors. Each body is a leaf (0.04 m, */
/* mid-wall) and a frame 0.925 m wide (12.5 mm past each jamb) and 0.12 m deep (10 mm proud of each face). Each is placed at its */
/* left jamb with local +Y to +y and states SINGLE_SWING_LEFT: hinged on local -X, opening to local +Y. */
#1=IFCPROJECT('3doorUnhostedProject01',$,'Door hosted in no wall',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
