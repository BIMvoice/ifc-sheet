#43=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall A',#42,2.,0.1);
#44=IFCEXTRUDEDAREASOLID(#43,#13,#11,3.);
#45=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#44));
#46=IFCPRODUCTDEFINITIONSHAPE($,$,(#45));
#47=IFCLOCALPLACEMENT(#24,#13);
#48=IFCWALL('3doorUnhostedWallA0001',$,'Wall A',$,$,#47,#46,$,.STANDARD.);
#50=IFCCARTESIANPOINT((3.95,0.05));
#51=IFCAXIS2PLACEMENT2D(#50,#40);
#52=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall B',#51,2.1,0.1);
#53=IFCEXTRUDEDAREASOLID(#52,#13,#11,3.);
#54=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#53));
#55=IFCPRODUCTDEFINITIONSHAPE($,$,(#54));
#56=IFCWALL('3doorUnhostedWallB0001',$,'Wall B',$,$,#47,#55,$,.STANDARD.);
#60=IFCCARTESIANPOINT((3.15,0.6));
#61=IFCAXIS2PLACEMENT2D(#60,#40);
#62=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall C',#61,0.1,1.);
#63=IFCEXTRUDEDAREASOLID(#62,#13,#11,3.);
#64=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#63));
#65=IFCPRODUCTDEFINITIONSHAPE($,$,(#64));
#66=IFCWALL('3doorUnhostedWallC0001',$,'Wall C',$,$,#47,#65,$,.STANDARD.);
/* The door's body, in its own placement (origin at the x = 2 jamb on the y = 0 face). */
#70=IFCCARTESIANPOINT((0.45,0.05));
#71=IFCAXIS2PLACEMENT2D(#70,#40);
#72=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf',#71,0.9,0.04);
#73=IFCEXTRUDEDAREASOLID(#72,#13,#11,2.1);
#74=IFCCARTESIANPOINT((0.0125,0.05));
#75=IFCAXIS2PLACEMENT2D(#74,#40);
#76=IFCRECTANGLEPROFILEDEF(.AREA.,'Frame',#75,0.05,0.12);
#77=IFCEXTRUDEDAREASOLID(#76,#13,#11,2.15);
#78=IFCCARTESIANPOINT((0.8875,0.05));
#79=IFCAXIS2PLACEMENT2D(#78,#40);
#80=IFCRECTANGLEPROFILEDEF(.AREA.,'Frame',#79,0.05,0.12);
#81=IFCEXTRUDEDAREASOLID(#80,#13,#11,2.15);
#90=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#73,#77,#81));
#91=IFCPRODUCTDEFINITIONSHAPE($,$,(#90));
#92=IFCCARTESIANPOINT((2.,0.,0.));
#93=IFCAXIS2PLACEMENT3D(#92,#11,#12);
