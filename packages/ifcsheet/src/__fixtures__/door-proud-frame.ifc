DATA;
/* Level 0 holds a 3 m high wall (x 0..6, y 0..0.125) with a 0.9 m by 2.1 m opening from x 2 to 2.9, filled by a door. The door's body is */
/* its leaf (0.04 m, in the wall) and a wrap-around frame whose casings stand proud of the wall's faces: 85 mm on the y = 0 face and */
/* 25 mm on the y = 0.125 face, 70 mm past each jamb, as the Umfassungszarge doors of a small house measured in the plan audit for #831. */
/* The door's placement is at the x = 2 jamb, local +Y to the 25 mm side, and it states SINGLE_SWING_LEFT: hinged on local -X (x = 2), */
/* opening to local +Y. A second door, the same, fills a second opening from x 4 to 4.9 under two narrower voids from x 4.15 to 4.75, */
/* 2.3 m to 2.45 m and 2.5 m to 2.65 m up: the wall's vertices round them lie inside the door's width, more of them than at the jambs, */
/* but all above the plan's cut, and are no jambs. */
#1=IFCPROJECT('3doorProudProject00001',$,'Door with a proud frame',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#30=IFCSITE('3doorProudSite00000001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3doorProudBuilding0001',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3doorProudLevel0000001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3doorProudAggProject01',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3doorProudAggSite00001',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3doorProudAggBuilding1',$,$,$,#31,(#32));
#40=IFCDIRECTION((1.,0.));
#41=IFCCARTESIANPOINT((3.,0.0625));
#42=IFCAXIS2PLACEMENT2D(#41,#40);
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall',#42,6.,0.125);
#44=IFCEXTRUDEDAREASOLID(#43,#13,#11,3.);
#45=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#44));
#46=IFCPRODUCTDEFINITIONSHAPE($,$,(#45));
#47=IFCLOCALPLACEMENT(#24,#13);
#48=IFCWALL('3doorProudWall00000001',$,'Wall',$,$,#47,#46,$,.STANDARD.);
#50=IFCCARTESIANPOINT((2.45,0.0625,0.));
#51=IFCAXIS2PLACEMENT3D(#50,#11,#12);
#52=IFCLOCALPLACEMENT(#24,#51);
#53=IFCCARTESIANPOINT((0.,0.));
#54=IFCAXIS2PLACEMENT2D(#53,#40);
#55=IFCRECTANGLEPROFILEDEF(.AREA.,'Opening',#54,0.9,0.5);
#56=IFCEXTRUDEDAREASOLID(#55,#13,#11,2.1);
#57=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#56));
#58=IFCPRODUCTDEFINITIONSHAPE($,$,(#57));
#59=IFCOPENINGELEMENT('3doorProudOpening00001',$,'Opening',$,$,#52,#58,$,.OPENING.);
#60=IFCRELVOIDSELEMENT('3doorProudVoids0000001',$,$,$,#48,#59);
/* The door's body, in its own placement (origin at the x = 2 jamb on the y = 0 face). */
#70=IFCCARTESIANPOINT((0.45,0.06));
#71=IFCAXIS2PLACEMENT2D(#70,#40);
#72=IFCRECTANGLEPROFILEDEF(.AREA.,'Leaf',#71,0.9,0.04);
#73=IFCEXTRUDEDAREASOLID(#72,#13,#11,2.1);
#74=IFCCARTESIANPOINT((-0.035,-0.0425));
#75=IFCAXIS2PLACEMENT2D(#74,#40);
#76=IFCRECTANGLEPROFILEDEF(.AREA.,'Casing',#75,0.07,0.085);
#77=IFCEXTRUDEDAREASOLID(#76,#13,#11,2.17);
#78=IFCCARTESIANPOINT((0.935,-0.0425));
#79=IFCAXIS2PLACEMENT2D(#78,#40);
#80=IFCRECTANGLEPROFILEDEF(.AREA.,'Casing',#79,0.07,0.085);
#81=IFCEXTRUDEDAREASOLID(#80,#13,#11,2.17);
#82=IFCCARTESIANPOINT((-0.035,0.1375));
#83=IFCAXIS2PLACEMENT2D(#82,#40);
#84=IFCRECTANGLEPROFILEDEF(.AREA.,'Casing',#83,0.07,0.025);
#85=IFCEXTRUDEDAREASOLID(#84,#13,#11,2.17);
#86=IFCCARTESIANPOINT((0.935,0.1375));
#87=IFCAXIS2PLACEMENT2D(#86,#40);
#88=IFCRECTANGLEPROFILEDEF(.AREA.,'Casing',#87,0.07,0.025);
#89=IFCEXTRUDEDAREASOLID(#88,#13,#11,2.17);
#90=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#73,#77,#81,#85,#89));
#91=IFCPRODUCTDEFINITIONSHAPE($,$,(#90));
#92=IFCCARTESIANPOINT((2.,0.,0.));
#93=IFCAXIS2PLACEMENT3D(#92,#11,#12);
#94=IFCLOCALPLACEMENT(#24,#93);
#95=IFCDOOR('3doorProudDoor00000001',$,'Door',$,$,#94,#91,$,2.1,0.9,.DOOR.,.SINGLE_SWING_LEFT.,$);
#96=IFCRELFILLSELEMENT('3doorProudFills0000001',$,$,$,#59,#95);
#100=IFCCARTESIANPOINT((4.45,0.0625,0.));
#101=IFCAXIS2PLACEMENT3D(#100,#11,#12);
#102=IFCLOCALPLACEMENT(#24,#101);
#103=IFCOPENINGELEMENT('3doorProudOpening00002',$,'Opening B',$,$,#102,#58,$,.OPENING.);
#104=IFCRELVOIDSELEMENT('3doorProudVoids0000002',$,$,$,#48,#103);
#105=IFCCARTESIANPOINT((4.45,0.0625,2.3));
#106=IFCAXIS2PLACEMENT3D(#105,#11,#12);
#107=IFCLOCALPLACEMENT(#24,#106);
#108=IFCRECTANGLEPROFILEDEF(.AREA.,'Fanlight',#54,0.6,0.5);
#109=IFCEXTRUDEDAREASOLID(#108,#13,#11,0.15);
#110=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#109));
#111=IFCPRODUCTDEFINITIONSHAPE($,$,(#110));
#112=IFCOPENINGELEMENT('3doorProudOpening00003',$,'Void above B',$,$,#107,#111,$,.OPENING.);
#113=IFCRELVOIDSELEMENT('3doorProudVoids0000003',$,$,$,#48,#112);
#120=IFCCARTESIANPOINT((4.45,0.0625,2.5));
#121=IFCAXIS2PLACEMENT3D(#120,#11,#12);
#122=IFCLOCALPLACEMENT(#24,#121);
#123=IFCOPENINGELEMENT('3doorProudOpening00004',$,'Second void above B',$,$,#122,#111,$,.OPENING.);
#124=IFCRELVOIDSELEMENT('3doorProudVoids0000004',$,$,$,#48,#123);
#114=IFCCARTESIANPOINT((4.,0.,0.));
#115=IFCAXIS2PLACEMENT3D(#114,#11,#12);
#116=IFCLOCALPLACEMENT(#24,#115);
#117=IFCDOOR('3doorProudDoor00000002',$,'Door B',$,$,#116,#91,$,2.1,0.9,.DOOR.,.SINGLE_SWING_LEFT.,$);
#118=IFCRELFILLSELEMENT('3doorProudFills0000002',$,$,$,#103,#117);
#99=IFCRELCONTAINEDINSPATIALSTRUCTURE('3doorProudContain00001',$,$,$,(#48,#95,#117),#32);
ENDSEC;
END-ISO-10303-21;
