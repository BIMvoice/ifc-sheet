ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Hand-written IFC4 fixture for what a plan draws above its cut (#490). A Ground floor at 0 and a First floor at 3.0 m. On the ground floor, a 5 x 4 m room of four 0.2 m walls 3.0 m high, and a beam across it at y 2.0 whose underside is at 2.6 m and top at 3.0 m. On the first floor, its floor slab from 3.0 to 3.2 m over x 0 to 6, so it overhangs the room by 1 m on the east, and a flat roof slab from 6.5 to 6.7 m over x -0.5 to 6.5 and y -0.5 to 4.5. No external data.'),'2;1');
FILE_NAME('overhead-plan.ifc','2026-11-10T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
