ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('oblique-wall-window.ifc','2026-11-27T00:00:00',('IfcSheet'),('IfcSheet'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* #831: wall A, 4 m long, 0.3 m thick, 3 m high, runs from the origin along (2,1), 26.6 degrees off the x axis, so the */
/* north elevation sees it at 26.6 degrees and the west elevation at 63.4 degrees. Its exterior face is wall-local y = 0.3 */
/* (world normal (-1,2)/sqrt5). Wall B, the 0-degree control, runs along x 8..12 with the same section, exterior face y = 0.3. */
/* Each has an opening 1.0 m wide, 0.9..2.1 m up, 1.5..2.5 m along the wall, cut through the whole wall, and a window */
/* 1.0 x 0.1 m (wall-local y 0.15..0.25) filling it, its outer face 50 mm in from the exterior face. */
#1=IFCPROJECT('3obliqueWallProject001',$,'Oblique wall',$,$,$,$,(#14),#9);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#9=IFCUNITASSIGNMENT((#2,#6));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#22=IFCLOCALPLACEMENT($,#13);
#23=IFCLOCALPLACEMENT(#22,#13);
#24=IFCLOCALPLACEMENT(#23,#13);
#30=IFCSITE('3obliqueWallSite000001',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCBUILDING('3obliqueWallBuilding01',$,'Building',$,$,#23,$,$,.ELEMENT.,$,$,$);
#32=IFCBUILDINGSTOREY('3obliqueWallLevel00001',$,'Level 0',$,$,#24,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('3obliqueWallAggProj001',$,$,$,#1,(#30));
#35=IFCRELAGGREGATES('3obliqueWallAggSite001',$,$,$,#30,(#31));
#36=IFCRELAGGREGATES('3obliqueWallAggBldg001',$,$,$,#31,(#32));
#40=IFCDIRECTION((1.,0.));
#41=IFCCARTESIANPOINT((2.,0.15));
#42=IFCAXIS2PLACEMENT2D(#41,#40);
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall',#42,4.,0.3);
#44=IFCEXTRUDEDAREASOLID(#43,#13,#11,3.);
#45=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#44));
#46=IFCPRODUCTDEFINITIONSHAPE($,$,(#45));
#47=IFCDIRECTION((0.8944271909999159,0.4472135954999579,0.));
#48=IFCAXIS2PLACEMENT3D(#10,#11,#47);
#49=IFCLOCALPLACEMENT(#24,#48);
#50=IFCWALL('3obliqueWallWallA00001',$,'Wall A',$,$,#49,#46,$,.STANDARD.);
#51=IFCCARTESIANPOINT((8.,0.,0.));
#52=IFCAXIS2PLACEMENT3D(#51,#11,#12);
#53=IFCLOCALPLACEMENT(#24,#52);
#54=IFCWALL('3obliqueWallWallB00001',$,'Wall B',$,$,#53,#46,$,.STANDARD.);
#60=IFCCARTESIANPOINT((2.,0.15,0.9));
#61=IFCAXIS2PLACEMENT3D(#60,#11,#12);
#62=IFCCARTESIANPOINT((0.,0.));
#63=IFCAXIS2PLACEMENT2D(#62,#40);
#64=IFCRECTANGLEPROFILEDEF(.AREA.,'Opening',#63,1.,0.5);
#65=IFCEXTRUDEDAREASOLID(#64,#13,#11,1.2);
#66=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#65));
#67=IFCPRODUCTDEFINITIONSHAPE($,$,(#66));
#68=IFCCARTESIANPOINT((2.,0.2,0.9));
#69=IFCAXIS2PLACEMENT3D(#68,#11,#12);
#70=IFCRECTANGLEPROFILEDEF(.AREA.,'Window',#63,1.,0.1);
#71=IFCEXTRUDEDAREASOLID(#70,#13,#11,1.2);
#72=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#71));
#73=IFCPRODUCTDEFINITIONSHAPE($,$,(#72));
#80=IFCLOCALPLACEMENT(#49,#61);
#81=IFCOPENINGELEMENT('3obliqueWallOpeningA01',$,'Opening A',$,$,#80,#67,$,.OPENING.);
#82=IFCRELVOIDSELEMENT('3obliqueWallVoidsA0001',$,$,$,#50,#81);
#83=IFCLOCALPLACEMENT(#49,#69);
#84=IFCWINDOW('3obliqueWallWindowA001',$,'Window A',$,$,#83,#73,$,1.2,1.,.WINDOW.,.SINGLE_PANEL.,$);
#85=IFCRELFILLSELEMENT('3obliqueWallFillsA0001',$,$,$,#81,#84);
#90=IFCLOCALPLACEMENT(#53,#61);
#91=IFCOPENINGELEMENT('3obliqueWallOpeningB01',$,'Opening B',$,$,#90,#67,$,.OPENING.);
#92=IFCRELVOIDSELEMENT('3obliqueWallVoidsB0001',$,$,$,#54,#91);
#93=IFCLOCALPLACEMENT(#53,#69);
#94=IFCWINDOW('3obliqueWallWindowB001',$,'Window B',$,$,#93,#73,$,1.2,1.,.WINDOW.,.SINGLE_PANEL.,$);
#95=IFCRELFILLSELEMENT('3obliqueWallFillsB0001',$,$,$,#91,#94);
#99=IFCRELCONTAINEDINSPATIALSTRUCTURE('3obliqueWallContain001',$,$,$,(#50,#54,#84,#94),#32);
ENDSEC;
END-ISO-10303-21;
