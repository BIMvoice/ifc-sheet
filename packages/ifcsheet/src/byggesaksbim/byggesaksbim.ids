<?xml version="1.0" encoding="UTF-8"?>
<!--
  ByggesaksBIM hard requirements, as an IDS 1.0 file. UNOFFICIAL: DiBK publishes no IDS.
  Source: DiBK, "P13 eByggesak" report (ARK, Forprosjekt, IFC4 ADD2 TC1), the Obligatorisk items (seven checks: the two IfcZone items, Reference and BRA, are one).
  Read and encoded 2026-10-26. The source table and the choices made are in README.md next to this file.
  Shipped as data: byggesaksbim-ids.ts holds the same text for the app and the command line, and
  byggesaksbim.test.ts fails when the two differ.
-->
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd"><info><title>ByggesaksBIM hard requirements (P13 eByggesak)</title><version>0.1</version><description>Seven Obligatorisk requirements of the DiBK P13 eByggesak report, ARK, Forprosjekt. An unofficial reading of DiBK P13; not published by DiBK. IFC4 only.</description><author>petru@bimvoice.com</author><date>2026-10-26</date><purpose>Unofficial reading of the DiBK P13 eByggesak report; not published by DiBK</purpose></info><specifications>
<specification ifcVersion="IFC4" name="Matrikkelnummer paa IfcSite" identifier="NO-H1" description="P13 502 Site: IfcSite.LandTitleNumber must be knr-gnr/bnr/fnr/snr (OBLIGATORISK)." instructions="knr four digits with leading zeros; gnr, bnr, fnr, snr without leading zeros; all four fields present, unused = 0; no other characters. Example 0904-200/2430/0/14."><applicability minOccurs="1" maxOccurs="unbounded"><entity><name><simpleValue>IFCSITE</simpleValue></name></entity></applicability><requirements><attribute cardinality="required"><name><simpleValue>LandTitleNumber</simpleValue></name><value><xs:restriction base="xs:string"><xs:pattern value="[0-9]{4}-(0|[1-9][0-9]*)/(0|[1-9][0-9]*)/(0|[1-9][0-9]*)/(0|[1-9][0-9]*)"/></xs:restriction></value></attribute></requirements></specification>
<specification ifcVersion="IFC4" name="BYA paa IfcBuilding" identifier="NO-H2" description="P13 503 Building: Pset_BuildingCommon.GrossPlannedArea = BYA, bebygd areal (OBLIGATORISK)." instructions="Footprint area of the building; cantilevers with clear height under 5.00 m included."><applicability minOccurs="1" maxOccurs="unbounded"><entity><name><simpleValue>IFCBUILDING</simpleValue></name></entity></applicability><requirements><property dataType="IFCAREAMEASURE" cardinality="required"><propertySet><simpleValue>Pset_BuildingCommon</simpleValue></propertySet><baseName><simpleValue>GrossPlannedArea</simpleValue></baseName></property></requirements></specification>
<specification ifcVersion="IFC4" name="Bygningstype paa IfcBuilding" identifier="NO-H3" description="P13 503 Building: Pset_BuildingCommon.OccupancyType = code from Geonorge register bygningstype (OBLIGATORISK)." instructions="Code value, e.g. 111, from https://register.geonorge.no/byggesoknad/bygningstype (code list not encoded)."><applicability minOccurs="1" maxOccurs="unbounded"><entity><name><simpleValue>IFCBUILDING</simpleValue></name></entity></applicability><requirements><property dataType="IFCLABEL" cardinality="required"><propertySet><simpleValue>Pset_BuildingCommon</simpleValue></propertySet><baseName><simpleValue>OccupancyType</simpleValue></baseName></property></requirements></specification>
<specification ifcVersion="IFC4" name="BTA per IfcBuildingStorey" identifier="NO-H4" description="P13 504 BuildingStorey: Pset_BuildingStoreyCommon.GrossPlannedArea = BTA (OBLIGATORISK)." instructions="Gross area per storey."><applicability minOccurs="1" maxOccurs="unbounded"><entity><name><simpleValue>IFCBUILDINGSTOREY</simpleValue></name></entity></applicability><requirements><property dataType="IFCAREAMEASURE" cardinality="required"><propertySet><simpleValue>Pset_BuildingStoreyCommon</simpleValue></propertySet><baseName><simpleValue>GrossPlannedArea</simpleValue></baseName></property></requirements></specification>
<specification ifcVersion="IFC4" name="BRA per IfcBuildingStorey" identifier="NO-H5" description="P13 504 BuildingStorey: Pset_BuildingStoreyCommon.NetPlannedArea = BRA (OBLIGATORISK)." instructions="Usable area per storey."><applicability minOccurs="1" maxOccurs="unbounded"><entity><name><simpleValue>IFCBUILDINGSTOREY</simpleValue></name></entity></applicability><requirements><property dataType="IFCAREAMEASURE" cardinality="required"><propertySet><simpleValue>Pset_BuildingStoreyCommon</simpleValue></propertySet><baseName><simpleValue>NetPlannedArea</simpleValue></baseName></property></requirements></specification>
<specification ifcVersion="IFC4" name="BRA per bruksenhet (IfcZone)" identifier="NO-H6" description="P13 508 Zone: Pset_ZoneCommon.NetPlannedArea = BRA per bruksenhet (OBLIGATORISK)." instructions="Only zones whose Pset_ZoneCommon.Reference is the string Bruksenhet are checked; any other IfcZone (a fire or HVAC zone) is out of scope."><applicability minOccurs="0" maxOccurs="unbounded"><entity><name><simpleValue>IFCZONE</simpleValue></name></entity><property dataType="IFCIDENTIFIER"><propertySet><simpleValue>Pset_ZoneCommon</simpleValue></propertySet><baseName><simpleValue>Reference</simpleValue></baseName><value><simpleValue>Bruksenhet</simpleValue></value></property></applicability><requirements><property dataType="IFCAREAMEASURE" cardinality="required"><propertySet><simpleValue>Pset_ZoneCommon</simpleValue></propertySet><baseName><simpleValue>NetPlannedArea</simpleValue></baseName></property></requirements></specification>
<specification ifcVersion="IFC4" name="Heistype paa IfcTransportElement" identifier="NO-H7" description="P13 212 TransportElement: IfcTransportElement.PredefinedType (OBLIGATORISK)." instructions="Lift type; the report gives no value list, so only a value is required."><applicability minOccurs="0" maxOccurs="unbounded"><entity><name><simpleValue>IFCTRANSPORTELEMENT</simpleValue></name></entity></applicability><requirements><attribute cardinality="required"><name><simpleValue>PredefinedType</simpleValue></name></attribute></requirements></specification>
</specifications></ids>
