    "directory": "packages/ifcsheet"
  },
  "homepage": "https://github.com/BIMvoice/ifcsheet#readme",
  "bugs": "https://github.com/BIMvoice/ifcsheet/issues",
  "keywords": [
    "ifc",
    "bim",
    "openbim",
    "drawings",
    "sheets",
    "pdf",
    "dxf",
    "cli",
    "architecture",
    "aec"
  ],
  "files": [
    "dist",
    "!dist/**/*.map",
    "fonts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
