{
  "name": "@bimvoice/ifcsheet",
  "version": "0.1.0",
  "private": true,
  "description": "IfcSheet: drawing sets (PDF and DXF) from IFC models. The ifcsheet command line and the drawing-set engine, in Node or the browser",
  "type": "module",
  "bin": {
    "ifcsheet": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
