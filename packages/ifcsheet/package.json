  "scripts": {
    "build": "pnpm exec tsc",
    "typecheck": "node ../../scripts/typecheck-tests.mjs",
    "dev": "pnpm exec tsc --watch",
    "test": "vitest run",
    "benchmark": "vitest run src/golden-sheets.models.test.ts",
    "benchmark:update": "IFCSHEET_BENCHMARK_UPDATE=1 vitest run src/golden-sheets.models.test.ts",
    "prepack": "node ../../scripts/copy-package-legal.mjs",
    "postpack": "node ../../scripts/copy-package-legal.mjs --clean"
  },
  "dependencies": {
    "@ifc-lite/create": "workspace:^",
    "@ifc-lite/data": "workspace:^",
    "@ifc-lite/drawing-2d": "workspace:^",
    "@ifc-lite/export": "workspace:^",
    "@ifc-lite/geometry": "workspace:^",
    "@ifc-lite/ids": "workspace:^",
    "@ifc-lite/lists": "workspace:^",
    "@ifc-lite/mutations": "workspace:^",
    "@ifc-lite/parser": "workspace:^",
    "@ifc-lite/rules": "workspace:^",
    "@ifc-lite/wasm": "workspace:^",
