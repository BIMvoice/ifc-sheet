#63=IFCLOCALPLACEMENT(#27,#13);
#64=IFCWALL('2fedArchWallC000000010',$,'Wall C',$,$,#63,#62,$,.STANDARD.);
#70=IFCCARTESIANPOINT((2.,0.1,0.));
#71=IFCAXIS2PLACEMENT3D(#70,#11,#12);
#72=IFCLOCALPLACEMENT(#24,#71);
#73=IFCCARTESIANPOINT((0.45,0.05));
