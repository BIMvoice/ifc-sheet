ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]','Synthetic fixture for tagging an IfcSign (#788): hand-written IFC4, two signs (a box each) on one storey, each with a Description, an ObjectType and a custom property set Acme_Signage'),'2;1');
FILE_NAME('signs-with-pset.ifc','2026-11-09T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#100=IFCCARTESIANPOINT((0.,0.,0.));
#101=IFCAXIS2PLACEMENT3D(#100,$,$);
#102=IFCLOCALPLACEMENT($,#101);
#103=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#101,$);
#104=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#106=IFCUNITASSIGNMENT((#104));
#107=IFCPROJECT('1SIGN0000000000000001',$,'Sign fixture',$,$,$,$,(#103),#106);
#108=IFCSITE('1SIGN0000000000000002',$,'Site',$,$,#102,$,$,.ELEMENT.,$,$,$,$,$);
#109=IFCBUILDING('1SIGN0000000000000003',$,'Building',$,$,#102,$,$,.ELEMENT.,$,$,$);
#110=IFCBUILDINGSTOREY('1SIGN0000000000000004',$,'Level 1',$,$,#102,$,$,.ELEMENT.,0.);
#111=IFCRELAGGREGATES('1SIGN0000000000000005',$,$,$,#107,(#108));
#112=IFCRELAGGREGATES('1SIGN0000000000000006',$,$,$,#108,(#109));
#113=IFCRELAGGREGATES('1SIGN0000000000000007',$,$,$,#109,(#110));
#150=IFCCARTESIANPOINT((0.,0.));
#151=IFCAXIS2PLACEMENT2D(#150,$);
#152=IFCRECTANGLEPROFILEDEF(.AREA.,$,#151,0.8,0.1);
#153=IFCDIRECTION((0.,0.,1.));
#154=IFCEXTRUDEDAREASOLID(#152,#101,#153,2.2);
#155=IFCSHAPEREPRESENTATION(#103,'Body','SweptSolid',(#154));
#156=IFCPRODUCTDEFINITIONSHAPE($,$,(#155));
#157=IFCCARTESIANPOINT((1.,1.,0.));
#158=IFCAXIS2PLACEMENT3D(#157,$,$);
#159=IFCLOCALPLACEMENT(#102,#158);
#160=IFCCARTESIANPOINT((4.,1.,0.));
#161=IFCAXIS2PLACEMENT3D(#160,$,$);
#162=IFCLOCALPLACEMENT(#102,#161);
#120=IFCSIGN('1SIGN0000000000000010',$,'Sign 01','Emergency exit, left stair','Exit sign',#159,#156,'S-01',.PICTORAL.);
#121=IFCSIGN('1SIGN0000000000000011',$,'Sign 02','Fire extinguisher point','Safety sign',#162,#156,'S-02',.PICTORAL.);
#130=IFCPROPERTYSINGLEVALUE('SignText',$,IFCLABEL('EXIT - IESIRE'),$);
#131=IFCPROPERTYSET('1SIGN0000000000000020',$,'Acme_Signage',$,(#130));
#132=IFCRELDEFINESBYPROPERTIES('1SIGN0000000000000021',$,$,$,(#120),#131);
#133=IFCPROPERTYSINGLEVALUE('SignText',$,IFCLABEL('EXTINGUISHER'),$);
#134=IFCPROPERTYSET('1SIGN0000000000000022',$,'Acme_Signage',$,(#133));
#135=IFCRELDEFINESBYPROPERTIES('1SIGN0000000000000023',$,$,$,(#121),#134);
#140=IFCRELCONTAINEDINSPATIALSTRUCTURE('1SIGN0000000000000030',$,$,$,(#120,#121),#110);
ENDSEC;
END-ISO-10303-21;
