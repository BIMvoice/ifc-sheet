ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]','Synthetic fixture for a plan placed off the model centre (#279): hand-built IFC4. Nivel 1 (0.0 m) holds four 3.0 m walls 0.2 m thick around an 8 x 6 m room (outer faces x 0..8, y 0..6); Nivel 2 (3.0 m) holds one 10 m wall (x 20..30, y 0..0.2, 3.0 m high), so the building is 30 m wide and each storey fills a different part of it. Every solid is an IfcExtrudedAreaSolid over a closed polyline.'),'2;1');
FILE_NAME('plan-off-centre-wing.ifc','2026-10-21T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
