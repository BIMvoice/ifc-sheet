ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Hand-written IFC4 test fixture for interior elevations (ifcsheet #94). One rectangular room, 4 m by 3 m inside, walls 0.2 m thick and 2.5 m high, the storey rotated 30 degrees counter-clockwise about Z. One window W1 in the north wall, 0.55 m to 1.25 m from its west end (in an opening 0.5 m to 1.3 m): on the left as seen from inside the room looking at that wall. A second, W2, in the east wall 0.4 m to 1.0 m from its north end (in an opening 0.35 m to 1.05 m): on the left as seen from inside facing east.'),'2;1');
FILE_NAME('rotated-room.ifc','2026-10-19T00:00:00',('ifcsheet'),('BIMvoice'),$,'hand-written',$);
FILE_SCHEMA(('IFC4'));
ENDSEC;
