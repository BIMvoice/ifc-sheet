#37=IFCSLAB('1RoofTwoWingsMainRoof1',$,'Main roof',$,$,#36,#33,$,.ROOF.);
#40=IFCRECTANGLEPROFILEDEF(.AREA.,$,#25,4.000,4.000);
#41=IFCEXTRUDEDAREASOLID(#40,#4,#29,0.200);
#42=IFCSHAPEREPRESENTATION(#6,'Body','SweptSolid',(#41));
#43=IFCPRODUCTDEFINITIONSHAPE($,$,(#42));
#44=IFCCARTESIANPOINT((9.000,2.000,2.600));
#45=IFCAXIS2PLACEMENT3D(#44,$,$);
#46=IFCLOCALPLACEMENT(#18,#45);
#47=IFCROOF('1RoofTwoWingsWingRoof1',$,'Wing roof',$,$,#46,#43,$,.FLAT_ROOF.);
#50=IFCRELAGGREGATES('1RoofTwoWingsAggr00001',$,$,$,#7,(#14));
#51=IFCRELAGGREGATES('1RoofTwoWingsAggr00002',$,$,$,#14,(#15));
#52=IFCRELAGGREGATES('1RoofTwoWingsAggr00003',$,$,$,#15,(#19,#23));
