ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Hand-written IFC4 fixture for the roof plan: a Ground floor at 0 and an Upper floor at 3.0 m. The main roof (an IfcSlab ROOF) tops the upper floor at 6.0 m; a lower wing beside it has its own roof (an IfcRoof) at 2.6 m, below the Upper floor level. Boxes only; no external data.'),'2;1');
FILE_NAME('roof-two-wings.ifc','2026-10-20T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCCARTESIANPOINT((0.000,0.000,0.000));
#4=IFCAXIS2PLACEMENT3D(#3,$,$);
#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);
#6=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#5,$,.MODEL_VIEW.,$);
#7=IFCPROJECT('1RoofTwoWingsProject01',$,'Roof plan fixture',$,$,$,$,(#5),#2);
#10=IFCLOCALPLACEMENT($,#4);
#13=IFCLOCALPLACEMENT(#10,#4);
#14=IFCSITE('1RoofTwoWingsSite00001',$,'Site',$,$,#10,$,$,.ELEMENT.,$,$,$,$,$);
#15=IFCBUILDING('1RoofTwoWingsBuilding1',$,'Building',$,$,#13,$,$,.ELEMENT.,$,$,$);
#18=IFCLOCALPLACEMENT(#13,#4);
