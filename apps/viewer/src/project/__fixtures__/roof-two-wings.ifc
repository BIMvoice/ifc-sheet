#20=IFCCARTESIANPOINT((0.000,0.000,3.000));
#21=IFCAXIS2PLACEMENT3D(#20,$,$);
#22=IFCLOCALPLACEMENT(#13,#21);
#23=IFCBUILDINGSTOREY('1RoofTwoWingsUpper0001',$,'Upper floor',$,$,#22,$,$,.ELEMENT.,3.000);
#24=IFCCARTESIANPOINT((0.,0.));
#25=IFCAXIS2PLACEMENT2D(#24,$);
#29=IFCDIRECTION((0.,0.,1.));
#30=IFCRECTANGLEPROFILEDEF(.AREA.,$,#25,6.000,4.000);
#31=IFCEXTRUDEDAREASOLID(#30,#4,#29,0.250);
#32=IFCSHAPEREPRESENTATION(#6,'Body','SweptSolid',(#31));
#33=IFCPRODUCTDEFINITIONSHAPE($,$,(#32));
#34=IFCCARTESIANPOINT((3.000,2.000,3.000));
