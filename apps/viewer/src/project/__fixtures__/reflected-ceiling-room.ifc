ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]','Synthetic fixture for reflected ceiling plans (#91): hand-built IFC4, one 8 x 6 m room on Level 1 (elevation 3.0 m) with four 3.0 m walls and a floor slab; an L-shaped IfcCovering CEILING (soffit 2.70 m above the level; present for x 0.1..7.9, y 0.1..2.5 and x 0.1..4.0, y 2.5..5.9, so the NE quarter is open) and one IfcLightFixture (0.6 m square, soffit 2.60 m) off-centre at x 6.0, y 1.2. Generated by a throwaway script from those dimensions; every solid is an IfcExtrudedAreaSolid over a closed polyline.'),'2;1');
FILE_NAME('reflected-ceiling-room.ifc','2026-10-19T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
