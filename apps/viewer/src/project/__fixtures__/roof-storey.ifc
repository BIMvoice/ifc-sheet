ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Hand-written IFC4 fixture for the roof plan with a top storey named Roof: a Ground floor at 0, an Upper floor at 3.0 m and a Roof storey at 6.3 m with nothing above its level. The main roof (an IfcSlab ROOF, contained in the Roof storey) has its body at 5.70 to 5.95 m, wholly below the Roof level; an upper-floor wall runs 3.0 to 5.7 m; a lower wing has a slab roof (an IfcSlab ROOF) at 2.8 to 3.0 m, contained in the Ground floor. Boxes only; no external data.'),'2;1');
FILE_NAME('roof-storey.ifc','2026-10-20T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
